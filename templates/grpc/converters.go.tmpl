package converters

import (
	types "{{ .Project.ProjectMeta.Module }}/internal/domain/{{ .Domain.Name }}"
	{{ .Domain.Name }}svc "{{ .Project.ProjectMeta.Module }}/internal/grpc/generated/services/{{ .Domain.Name }}"

	"{{ .Project.ProjectMeta.PlatformModule }}/identifiers"

	"google.golang.org/protobuf/types/known/timestamppb"
)

// Convert{{ .Entity.Name }}ToGRPC{{ .Entity.Name }} converts a domain {{ .Entity.Name }} to its gRPC representation.
func Convert{{ .Entity.Name }}ToGRPC{{ .Entity.Name }}(x *types.{{ .Entity.Name }}) *{{ .Domain.Name }}svc.{{ .Entity.Name }} {
	if x == nil {
		return nil
	}

	result := &{{ .Domain.Name }}svc.{{ .Entity.Name }}{
		Id:        x.ID,
{{- range .Entity.Fields }}
		{{ .Name }}: x.{{ .Name }},
{{- end }}
		CreatedAt: timestamppb.New(x.CreatedAt),
{{- if .Entity.CreatedByUser }}
		CreatedByUser: x.CreatedByUser,
{{- end }}
{{- if .Entity.BelongsToAccount }}
		BelongsToAccount: x.BelongsToAccount,
{{- end }}
	}

	if x.LastUpdatedAt != nil {
		result.LastUpdatedAt = timestamppb.New(*x.LastUpdatedAt)
	}
	if x.ArchivedAt != nil {
		result.ArchivedAt = timestamppb.New(*x.ArchivedAt)
	}

	return result
}

// ConvertGRPC{{ .Entity.Name }}CreationRequestInputTo{{ .Entity.Name }}DatabaseCreationInput converts a gRPC creation request to a database creation input.
func ConvertGRPC{{ .Entity.Name }}CreationRequestInputTo{{ .Entity.Name }}DatabaseCreationInput(input *{{ .Domain.Name }}svc.{{ .Entity.Name }}CreationRequestInput, userID, accountID string) *types.{{ .Entity.Name }}DatabaseCreationInput {
	return &types.{{ .Entity.Name }}DatabaseCreationInput{
		ID: identifiers.New(),
{{- range creatableFields .Entity.Fields }}
		{{ .Name }}: input.{{ .Name }},
{{- end }}
{{- if .Entity.CreatedByUser }}
		CreatedByUser: userID,
{{- end }}
{{- if .Entity.BelongsToAccount }}
		BelongsToAccount: accountID,
{{- end }}
	}
}

// ConvertGRPC{{ .Entity.Name }}UpdateRequestInputTo{{ .Entity.Name }}UpdateRequestInput converts a gRPC update request to a domain update input.
func ConvertGRPC{{ .Entity.Name }}UpdateRequestInputTo{{ .Entity.Name }}UpdateRequestInput(input *{{ .Domain.Name }}svc.{{ .Entity.Name }}UpdateRequestInput) *types.{{ .Entity.Name }}UpdateRequestInput {
	return &types.{{ .Entity.Name }}UpdateRequestInput{
{{- range editableFields .Entity.Fields }}
		{{ .Name }}: input.{{ .Name }},
{{- end }}
	}
}

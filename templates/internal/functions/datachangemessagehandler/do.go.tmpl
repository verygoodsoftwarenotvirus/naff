package datachangemessagehandler

import (
	"context"

	"{{ .Project.ProjectMeta.Module }}/internal/config"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/auth"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/dataprivacy"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/identity"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/internalops"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/mealplanning"
	notificationsmanager "{{ .Project.ProjectMeta.Module }}/internal/domain/notifications/manager"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/webhooks"
	identityindexing "{{ .Project.ProjectMeta.Module }}/internal/services/identity/indexing"
	mealplanningindexing "{{ .Project.ProjectMeta.Module }}/internal/services/mealplanning/indexing"

	"{{ .Project.ProjectMeta.PlatformModule }}/analytics"
	"{{ .Project.ProjectMeta.PlatformModule }}/email"
	"{{ .Project.ProjectMeta.PlatformModule }}/encoding"
	"{{ .Project.ProjectMeta.PlatformModule }}/messagequeue"
	notifications "{{ .Project.ProjectMeta.PlatformModule }}/notifications/mobile"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/logging"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/metrics"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/tracing"
	"{{ .Project.ProjectMeta.PlatformModule }}/uploads"

	"github.com/samber/do/v2"

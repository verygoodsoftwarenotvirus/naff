package mealplangrocerylistinitializer

import (
	"context"

	"{{ .Project.ProjectMeta.Module }}/internal/config"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/mealplanning/grocerylistpreparation"
	auditlogentries "{{ .Project.ProjectMeta.Module }}/internal/repositories/postgres/audit"
	"{{ .Project.ProjectMeta.Module }}/internal/repositories/postgres/identity"
	"{{ .Project.ProjectMeta.Module }}/internal/repositories/postgres/mealplanning"
	mealplangrocerylistinitializer "{{ .Project.ProjectMeta.Module }}/internal/services/mealplanning/workers/meal_plan_grocery_list_initializer"

	databasecfg "{{ .Project.ProjectMeta.PlatformModule }}/database/config"
	"{{ .Project.ProjectMeta.PlatformModule }}/database/postgres"
	msgconfig "{{ .Project.ProjectMeta.PlatformModule }}/messagequeue/config"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability"
	loggingcfg "{{ .Project.ProjectMeta.PlatformModule }}/observability/logging/config"
	metricscfg "{{ .Project.ProjectMeta.PlatformModule }}/observability/metrics/config"
	tracingcfg "{{ .Project.ProjectMeta.PlatformModule }}/observability/tracing/config"

	"github.com/samber/do/v2"
)

// BuildInjector creates and configures the dependency injection container.
func BuildInjector(
	ctx context.Context,
	cfg *config.MealPlanGroceryListInitializerConfig,
) *do.RootScope {
	i := do.New()

	do.ProvideValue(i, ctx)
	do.ProvideValue(i, cfg)

	RegisterConfigs(i)

	observability.RegisterO11yConfigs(i)
	tracingcfg.RegisterTracerProvider(i)
	loggingcfg.RegisterLogger(i)
	metricscfg.RegisterMetricsProvider(i)
	databasecfg.RegisterClientConfig(i)
	postgres.RegisterDatabaseClient(i)
	msgconfig.RegisterMessageQueue(i)
	grocerylistpreparation.RegisterGroceryListCreator(i)
	auditlogentries.RegisterAuditLogRepository(i)
	identity.RegisterIdentityRepository(i)
	mealplanning.RegisterMealPlanningRepository(i)
	mealplangrocerylistinitializer.RegisterMealPlanGroceryListInitializer(i)

	return i
}

// Build builds a server.
func Build(
	ctx context.Context,
	cfg *config.MealPlanGroceryListInitializerConfig,
) (*mealplangrocerylistinitializer.Worker, error) {
	i := BuildInjector(ctx, cfg)
	return do.MustInvoke[*mealplangrocerylistinitializer.Worker](i), nil
}

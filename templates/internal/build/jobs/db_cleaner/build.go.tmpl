package dbcleaner

import (
	"context"

	"{{ .Project.ProjectMeta.Module }}/internal/config"
	"{{ .Project.ProjectMeta.Module }}/internal/repositories/postgres/internalops"
	dbcleaner "{{ .Project.ProjectMeta.Module }}/internal/services/oauth/workers/db_cleaner"

	databasecfg "{{ .Project.ProjectMeta.PlatformModule }}/database/config"
	"{{ .Project.ProjectMeta.PlatformModule }}/database/postgres"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability"
	loggingcfg "{{ .Project.ProjectMeta.PlatformModule }}/observability/logging/config"
	metricscfg "{{ .Project.ProjectMeta.PlatformModule }}/observability/metrics/config"
	tracingcfg "{{ .Project.ProjectMeta.PlatformModule }}/observability/tracing/config"

	"github.com/samber/do/v2"
)

// BuildInjector creates and configures the dependency injection container.
func BuildInjector(
	ctx context.Context,
	cfg *config.DBCleanerConfig,
) *do.RootScope {
	i := do.New()

	do.ProvideValue(i, ctx)
	do.ProvideValue(i, cfg)

	RegisterConfigs(i)

	observability.RegisterO11yConfigs(i)
	tracingcfg.RegisterTracerProvider(i)
	loggingcfg.RegisterLogger(i)
	metricscfg.RegisterMetricsProvider(i)
	databasecfg.RegisterClientConfig(i)
	postgres.RegisterDatabaseClient(i)
	internalops.RegisterInternalOpsRepository(i)
	dbcleaner.RegisterDBCleaner(i)

	return i
}

// Build builds a server.
func Build(
	ctx context.Context,
	cfg *config.DBCleanerConfig,
) (*dbcleaner.Job, error) {
	i := BuildInjector(ctx, cfg)
	return do.MustInvoke[*dbcleaner.Job](i), nil
}

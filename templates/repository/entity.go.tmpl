// Get{{ .Entity.Name }} fetches {{ withArticle .Entity.Name }} from the database.
func (r *repository) Get{{ .Entity.Name }}(ctx context.Context, {{ camel .Entity.Name }}ID string) (*types.{{ .Entity.Name }}, error) {
	ctx, span := r.tracer.StartSpan(ctx)
	defer span.End()

	logger := r.logger.Clone()

	if {{ camel .Entity.Name }}ID == "" {
		return nil, platformerrors.ErrInvalidIDProvided
	}
	logger = logger.WithValue({{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}ID)
	tracing.AttachToSpan(span, {{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}ID)

	result, err := r.generatedQuerier.Get{{ .Entity.Name }}(ctx, r.readDB, {{ camel .Entity.Name }}ID)
	if err != nil {
		return nil, observability.PrepareAndLogError(err, logger, span, "fetching {{ humanReadable .Entity.Name }}")
	}

	x := &types.{{ .Entity.Name }}{
		ID:            result.ID,
{{- range .Entity.Fields }}
{{- $fn := readConversionFunc . }}
{{- if $fn }}
		{{ .Name }}:   database.{{ $fn }}(result.{{ .Name }}),
{{- else }}
		{{ .Name }}:   result.{{ .Name }},
{{- end }}
{{- end }}
		CreatedAt:     result.CreatedAt,
		LastUpdatedAt: database.TimePointerFromNullTime(result.LastUpdatedAt),
		ArchivedAt:    database.TimePointerFromNullTime(result.ArchivedAt),
{{- if .Entity.CreatedByUser }}
		CreatedByUser: result.CreatedByUser,
{{- end }}
{{- if .Entity.BelongsToAccount }}
		BelongsToAccount: result.BelongsToAccount,
{{- end }}
	}

	return x, nil
}

// Get{{ plural .Entity.Name }} fetches a list of {{ pluralHumanReadable .Entity.Name }} from the database that meet a particular filter.
func (r *repository) Get{{ plural .Entity.Name }}(ctx context.Context, filter *filtering.QueryFilter) (*filtering.QueryFilteredResult[types.{{ .Entity.Name }}], error) {
	ctx, span := r.tracer.StartSpan(ctx)
	defer span.End()

	logger := r.logger.Clone()

	if filter == nil {
		filter = filtering.DefaultQueryFilter()
	}
	logger = filter.AttachToLogger(logger)
	tracing.AttachQueryFilterToSpan(span, filter)

	results, err := r.generatedQuerier.Get{{ plural .Entity.Name }}(ctx, r.readDB, &generated.Get{{ plural .Entity.Name }}Params{
		CreatedAfter:    database.NullTimeFromTimePointer(filter.CreatedAfter),
		CreatedBefore:   database.NullTimeFromTimePointer(filter.CreatedBefore),
		UpdatedBefore:   database.NullTimeFromTimePointer(filter.UpdatedBefore),
		UpdatedAfter:    database.NullTimeFromTimePointer(filter.UpdatedAfter),
		IncludeArchived: database.NullBoolFromBoolPointer(filter.IncludeArchived),
		Cursor:          database.NullStringFromStringPointer(filter.Cursor),
		ResultLimit:     database.NullInt32FromUint8Pointer(filter.MaxResponseSize),
	})
	if err != nil {
		return nil, observability.PrepareAndLogError(err, logger, span, "fetching {{ pluralHumanReadable .Entity.Name }} from database")
	}

	var (
		data                      []*types.{{ .Entity.Name }}
		filteredCount, totalCount uint64
	)
	for _, result := range results {
		data = append(data, &types.{{ .Entity.Name }}{
			ID:            result.ID,
{{- range .Entity.Fields }}
{{- $fn := readConversionFunc . }}
{{- if $fn }}
			{{ .Name }}:   database.{{ $fn }}(result.{{ .Name }}),
{{- else }}
			{{ .Name }}:   result.{{ .Name }},
{{- end }}
{{- end }}
			CreatedAt:     result.CreatedAt,
			LastUpdatedAt: database.TimePointerFromNullTime(result.LastUpdatedAt),
			ArchivedAt:    database.TimePointerFromNullTime(result.ArchivedAt),
{{- if .Entity.CreatedByUser }}
			CreatedByUser: result.CreatedByUser,
{{- end }}
{{- if .Entity.BelongsToAccount }}
			BelongsToAccount: result.BelongsToAccount,
{{- end }}
		})

		filteredCount = uint64(result.FilteredCount)
		totalCount = uint64(result.TotalCount)
	}

	x := filtering.NewQueryFilteredResult(
		data,
		filteredCount,
		totalCount,
		func(t *types.{{ .Entity.Name }}) string {
			return t.ID
		},
		filter,
	)

	return x, nil
}


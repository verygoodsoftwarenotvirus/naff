// Create{{ .Entity.Name }} creates {{ withArticle .Entity.Name }} in the database.
func (r *repository) Create{{ .Entity.Name }}(ctx context.Context, input *types.{{ .Entity.Name }}DatabaseCreationInput) (*types.{{ .Entity.Name }}, error) {
	ctx, span := r.tracer.StartSpan(ctx)
	defer span.End()

	logger := r.logger.Clone()

	if input == nil {
		return nil, platformerrors.ErrNilInputProvided
	}
{{- if .Entity.BelongsToAccount }}
	tracing.AttachToSpan(span, identitykeys.AccountIDKey, input.BelongsToAccount)
	logger = logger.WithValue(identitykeys.AccountIDKey, input.BelongsToAccount)
{{- end }}

	logger.Debug("Create{{ .Entity.Name }} invoked")

	tx, err := r.writeDB.BeginTx(ctx, nil)
	if err != nil {
		return nil, observability.PrepareAndLogError(err, logger, span, "beginning transaction")
	}

	if err = r.generatedQuerier.Create{{ .Entity.Name }}(ctx, tx, &generated.Create{{ .Entity.Name }}Params{
		ID:            input.ID,
{{- range creatableFields .Entity.Fields }}
{{- $fn := writeConversionFunc . }}
{{- if $fn }}
		{{ .Name }}:   database.{{ $fn }}(input.{{ .Name }}),
{{- else }}
		{{ .Name }}:   input.{{ .Name }},
{{- end }}
{{- end }}
{{- if .Entity.CreatedByUser }}
		CreatedByUser: input.CreatedByUser,
{{- end }}
{{- if .Entity.BelongsToAccount }}
		BelongsToAccount: input.BelongsToAccount,
{{- end }}
	}); err != nil {
		r.RollbackTransaction(ctx, tx)
		return nil, observability.PrepareAndLogError(err, logger, span, "performing {{ humanReadable .Entity.Name }} creation query")
	}

	x := &types.{{ .Entity.Name }}{
		ID:            input.ID,
{{- range creatableFields .Entity.Fields }}
		{{ .Name }}:   input.{{ .Name }},
{{- end }}
{{- if .Entity.CreatedByUser }}
		CreatedByUser: input.CreatedByUser,
{{- end }}
{{- if .Entity.BelongsToAccount }}
		BelongsToAccount: input.BelongsToAccount,
{{- end }}
		CreatedAt:     r.CurrentTime(),
	}

{{- if ne .Domain.Name "audit" }}
	if _, err = r.auditLogEntryRepo.CreateAuditLogEntry(ctx, &audit.AuditLogEntryDatabaseCreationInput{
{{- if .Entity.BelongsToAccount }}
		BelongsToAccount: &x.BelongsToAccount,
{{- end }}
		ID:               identifiers.New(),
		ResourceType:     resourceType{{ plural .Entity.Name }},
		RelevantID:       x.ID,
		EventType:        "created",
	}); err != nil {
		r.RollbackTransaction(ctx, tx)
		return nil, observability.PrepareError(err, span, "creating audit log entry")
	}
{{- end }}

	if err = tx.Commit(); err != nil {
		return nil, observability.PrepareAndLogError(err, logger, span, "committing database transaction")
	}

	tracing.AttachToSpan(span, {{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, x.ID)

	return x, nil
}

// Update{{ .Entity.Name }} updates {{ withArticle .Entity.Name }} in the database.
func (r *repository) Update{{ .Entity.Name }}(ctx context.Context, {{ camel .Entity.Name }} *types.{{ .Entity.Name }}) error {
	ctx, span := r.tracer.StartSpan(ctx)
	defer span.End()

	logger := r.logger.Clone()

	if {{ camel .Entity.Name }} == nil {
		return platformerrors.ErrNilInputProvided
	}
	logger = logger.WithValue({{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}.ID)
	tracing.AttachToSpan(span, {{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}.ID)

	tx, err := r.writeDB.BeginTx(ctx, nil)
	if err != nil {
		return observability.PrepareAndLogError(err, logger, span, "beginning transaction")
	}

	rowsAffected, err := r.generatedQuerier.Update{{ .Entity.Name }}(ctx, tx, &generated.Update{{ .Entity.Name }}Params{
		ID:            {{ camel .Entity.Name }}.ID,
{{- range editableFields .Entity.Fields }}
{{- $fn := writeConversionFunc . }}
{{- if $fn }}
		{{ .Name }}:   database.{{ $fn }}({{ camel $.Entity.Name }}.{{ .Name }}),
{{- else }}
		{{ .Name }}:   {{ camel $.Entity.Name }}.{{ .Name }},
{{- end }}
{{- end }}
	})
	if err != nil {
		r.RollbackTransaction(ctx, tx)
		return observability.PrepareAndLogError(err, logger, span, "updating {{ humanReadable .Entity.Name }}")
	}

	if rowsAffected == 0 {
		return sql.ErrNoRows
	}

{{- if ne .Domain.Name "audit" }}
	if _, err = r.auditLogEntryRepo.CreateAuditLogEntry(ctx, &audit.AuditLogEntryDatabaseCreationInput{
{{- if .Entity.BelongsToAccount }}
		BelongsToAccount: &{{ camel .Entity.Name }}.BelongsToAccount,
{{- end }}
		ID:               identifiers.New(),
		ResourceType:     resourceType{{ plural .Entity.Name }},
		RelevantID:       {{ camel .Entity.Name }}.ID,
		EventType:        "updated",
	}); err != nil {
		r.RollbackTransaction(ctx, tx)
		return observability.PrepareError(err, span, "creating audit log entry")
	}
{{- end }}

	if err = tx.Commit(); err != nil {
		return observability.PrepareAndLogError(err, logger, span, "committing database transaction")
	}

	return nil
}

// Archive{{ .Entity.Name }} archives {{ withArticle .Entity.Name }} from the database.
func (r *repository) Archive{{ .Entity.Name }}(ctx context.Context, {{ camel .Entity.Name }}ID string) error {
	ctx, span := r.tracer.StartSpan(ctx)
	defer span.End()

	if {{ camel .Entity.Name }}ID == "" {
		return platformerrors.ErrInvalidIDProvided
	}
	tracing.AttachToSpan(span, {{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}ID)

	logger := r.logger.WithValue({{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}ID)

{{- if ne .Domain.Name "audit" }}
	{{ camel .Entity.Name }}, err := r.Get{{ .Entity.Name }}(ctx, {{ camel .Entity.Name }}ID)
	if err != nil {
		return observability.PrepareAndLogError(err, logger, span, "fetching {{ humanReadable .Entity.Name }} for archive")
	}
{{- end }}

	tx, err := r.writeDB.BeginTx(ctx, nil)
	if err != nil {
		return observability.PrepareAndLogError(err, logger, span, "beginning transaction")
	}

	rowsAffected, err := r.generatedQuerier.Archive{{ .Entity.Name }}(ctx, tx, {{ camel .Entity.Name }}ID)
	if err != nil {
		r.RollbackTransaction(ctx, tx)
		return observability.PrepareAndLogError(err, logger, span, "archiving {{ humanReadable .Entity.Name }}")
	}

	if rowsAffected == 0 {
		r.RollbackTransaction(ctx, tx)
		return sql.ErrNoRows
	}

{{- if ne .Domain.Name "audit" }}
	if _, err = r.auditLogEntryRepo.CreateAuditLogEntry(ctx, &audit.AuditLogEntryDatabaseCreationInput{
{{- if .Entity.BelongsToAccount }}
		BelongsToAccount: &{{ camel .Entity.Name }}.BelongsToAccount,
{{- end }}
		ID:               identifiers.New(),
		ResourceType:     resourceType{{ plural .Entity.Name }},
		RelevantID:       {{ camel .Entity.Name }}ID,
		EventType:        "archived",
	}); err != nil {
		r.RollbackTransaction(ctx, tx)
		return observability.PrepareError(err, span, "creating audit log entry")
	}
{{- end }}

	if err = tx.Commit(); err != nil {
		return observability.PrepareAndLogError(err, logger, span, "committing database transaction")
	}

	return nil
}

func Test{{ .Entity.Name }}_Update(T *testing.T) {
	T.Parallel()

	T.Run("standard", func(t *testing.T) {
		t.Parallel()

		x := &{{ .Entity.Name }}{}
		input := &{{ .Entity.Name }}UpdateRequestInput{}

		assert.NoError(t, fake.Struct(&input))

		x.Update(input)
	})

	T.Run("nil input", func(t *testing.T) {
		t.Parallel()

		x := &{{ .Entity.Name }}{}
		x.Update(nil)
	})
}


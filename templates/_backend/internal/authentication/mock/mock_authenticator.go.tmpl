package mockauthn

import (
	"context"

	"{{ .Project.ProjectMeta.Module }}/internal/authentication"

	"github.com/stretchr/testify/mock"
)

var _ authentication.Authenticator = (*Authenticator)(nil)

// Authenticator is a mock Authenticator.
type Authenticator struct {
	mock.Mock
}

// PasswordMatches satisfies our authenticator interface.
func (m *Authenticator) PasswordMatches(ctx context.Context, hash, password string) (bool, error) {
	args := m.Called(ctx, hash, password)

	return args.Bool(0), args.Error(1)
}

// HashPassword satisfies our authenticator interface.
func (m *Authenticator) HashPassword(ctx context.Context, password string) (string, error) {
	args := m.Called(ctx, password)
	return args.String(0), args.Error(1)
}

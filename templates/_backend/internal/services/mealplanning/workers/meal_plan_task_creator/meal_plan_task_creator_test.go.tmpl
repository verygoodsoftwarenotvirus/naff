	"{{ .Project.ProjectMeta.Module }}/internal/domain/mealplanning"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/mealplanning/fakes"
	mealplanningmock "{{ .Project.ProjectMeta.Module }}/internal/domain/mealplanning/mocks"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/mealplanning/recipeanalysis"
	"{{ .Project.ProjectMeta.Module }}/internal/testutils"

	"github.com/primandproper/platform/messagequeue"

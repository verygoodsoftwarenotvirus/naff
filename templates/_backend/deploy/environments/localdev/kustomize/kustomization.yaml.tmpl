---
# See: https://kubectl.docs.kubernetes.io/references/kustomize/kustomization/
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

# See: https://kubectl.docs.kubernetes.io/references/kustomize/kustomization/resource/
resources:
  - namespace.yaml
  - ../../../kustomize/components/api_server
  - ../../../kustomize/components/workers
  # Uncomment to enable MCP server deployment
  # - ../../../kustomize/components/mcp_server

# See: https://kubectl.docs.kubernetes.io/references/kustomize/kustomization/patches/
patches:
  # API Server - override hostnames for K8s and use local images
  - path: patches/deployment-k8s-hostnames.yaml
    target:
      version: v1
      kind: Deployment
      name: {{ .Project.ProjectMeta.Kebab }}-service-api-deployment
  - path: patches/deployment-local-image-pull.yaml
    target:
      version: v1
      kind: Deployment
      name: {{ .Project.ProjectMeta.Kebab }}-service-api-deployment

  # DB Cleaner CronJob
  - path: patches/cronjob-k8s-hostnames.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-db-cleaner
  - path: patches/cronjob-local-image-pull.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-db-cleaner

  # Email Deliverability Test CronJob
  - path: patches/cronjob-k8s-hostnames.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-email-deliverability-test
  - path: patches/cronjob-local-image-pull.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-email-deliverability-test

  # Queue Test CronJob
  - path: patches/cronjob-k8s-hostnames.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-queue-test
  - path: patches/cronjob-local-image-pull.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-queue-test

  # Meal Plan Finalizer CronJob
  - path: patches/cronjob-k8s-hostnames.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-finalizer
  - path: patches/cronjob-local-image-pull.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-finalizer

  # Meal Plan Grocery List Init CronJob
  - path: patches/cronjob-k8s-hostnames.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-grocery-list-init
  - path: patches/cronjob-local-image-pull.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-grocery-list-init

  # Meal Plan Task Creator CronJob
  - path: patches/cronjob-k8s-hostnames.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-task-creator
  - path: patches/cronjob-local-image-pull.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-task-creator

  # Search Data Index Scheduler CronJob
  - path: patches/cronjob-k8s-hostnames.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-search-data-index-scheduler
  - path: patches/cronjob-local-image-pull.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-search-data-index-scheduler

  # Mobile Notification Scheduler CronJob
  - path: patches/cronjob-k8s-hostnames.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-mobile-notification-scheduler
  - path: patches/cronjob-local-image-pull.yaml
    target:
      kind: CronJob
      name: {{ .Project.ProjectMeta.Kebab }}-job-mobile-notification-scheduler

labels:
  - pairs:
      app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-backend
      deployed_by: skaffold

# Config files are symlinked from ../config_files/ to avoid duplication
# K8s-specific hostnames are injected via env var patches above
configMapGenerator:
  - name: {{ .Project.ProjectMeta.Kebab }}-service-api-config
    namespace: localdev
    files:
      - config.json=configs/api_service_config.json

  - name: {{ .Project.ProjectMeta.Kebab }}-job-db-cleaner-config
    namespace: localdev
    files:
      - config.json=configs/job_db_cleaner_config.json

  - name: {{ .Project.ProjectMeta.Kebab }}-job-email-deliverability-test-config
    namespace: localdev
    files:
      - config.json=configs/job_email_deliverability_test_config.json

  - name: {{ .Project.ProjectMeta.Kebab }}-job-queue-test-config
    namespace: localdev
    files:
      - config.json=configs/job_queue_test_config.json

  - name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-finalizer-config
    namespace: localdev
    files:
      - config.json=configs/job_meal_plan_finalizer_config.json

  - name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-grocery-list-init-config
    namespace: localdev
    files:
      - config.json=configs/job_meal_plan_grocery_list_initializer_config.json

  - name: {{ .Project.ProjectMeta.Kebab }}-job-meal-plan-task-creator-config
    namespace: localdev
    files:
      - config.json=configs/job_meal_plan_task_creator_config.json

  - name: {{ .Project.ProjectMeta.Kebab }}-job-search-data-index-scheduler-config
    namespace: localdev
    files:
      - config.json=configs/job_search_data_index_scheduler_config.json

  - name: {{ .Project.ProjectMeta.Kebab }}-job-mobile-notification-scheduler-config
    namespace: localdev
    files:
      - config.json=configs/job_mobile_notification_scheduler_config.json

  # Uncomment to enable MCP server deployment
  # - name: {{ .Project.ProjectMeta.Kebab }}-mcp-server-config
  #   namespace: localdev
  #   files:
  #     - config.json=configs/mcp_server_config.json

generatorOptions:
  disableNameSuffixHash: true
  labels:
    generated_by: skaffold
    deployed_by: skaffold
  annotations:
    generated_by: skaffold
    deployed_by: skaffold

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Project.ProjectMeta.Kebab }}-async-message-handler-deployment
  labels:
    app: {{ .Project.ProjectMeta.Kebab }}-backend
    app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-backend-services
spec:
  progressDeadlineSeconds: 1200
  selector:
    matchLabels:
      app: {{ .Project.ProjectMeta.Kebab }}-backend
      app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-backend-services
  replicas: 1
  template:
    metadata:
      labels:
        app: {{ .Project.ProjectMeta.Kebab }}-backend
        app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-backend-services
    spec:
      containers:
        - name: {{ .Project.ProjectMeta.Kebab }}-async-message-handler
          image: {{ .Project.ProjectMeta.Kebab }}-async-message-handler
          imagePullPolicy: Always
          env:
            - name: "CONFIGURATION_FILEPATH"
              value: "/etc/service-config.json"
            - name: "RUNNING_IN_KUBERNETES"
              value: "true"
            - name: "DINNER_DONE_BETTER_OBSERVABILITY_METRICS_OTEL_SERVICE_NAME"
              value: "{{ .Project.ProjectMeta.Snake }}_async_function_handler"
            - name: "DINNER_DONE_BETTER_OBSERVABILITY_TRACING_TRACING_SERVICE_NAME"
              value: "{{ .Project.ProjectMeta.Snake }}_async_function_handler"
          volumeMounts:
            - name: "config"
              mountPath: "/etc/service-config.json"
              subPath: "config.json"
          resources:
            requests:
              memory: "32Mi"
              cpu: "25m"
            limits:
              memory: "128Mi"
              cpu: "100m"
      volumes:
        - name: "config"
          configMap:
            name: "{{ .Project.ProjectMeta.Kebab }}-async-message-handler-config"
---

---
apiVersion: v1
kind: Service
metadata:
  name: {{ .Project.ProjectMeta.Kebab }}-api-svc
  labels:
    app: {{ .Project.ProjectMeta.Kebab }}-backend
    app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-backend
spec:
  selector:
    app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-backend
  ports:
    - name: http
      port: 8000
      protocol: TCP
      targetPort: http
    - name: grpc
      port: 8001
      protocol: TCP
      targetPort: grpc
  type: ClusterIP
---

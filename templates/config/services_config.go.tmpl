package config

import "context"

// ServicesConfig collects per-service configurations. In the generic skeleton
// this is empty; projects that want service-level config can template this
// file on .AllDomains and embed each domain's config type here. Target's
// version hardcodes dataprivacy/identity/mealplanning/oauth/payments/
// uploadedmedia/auth-handlers config structs — not emitted in the generic
// path because those service config packages are not generated.
type ServicesConfig struct {
	_ struct{} `json:"-"`
}

// ValidateWithContext returns nil — nothing to validate in the empty skeleton.
// Projects that populate ServicesConfig should override this to fan out to
// each embedded config's ValidateWithContext.
func (cfg *ServicesConfig) ValidateWithContext(_ context.Context) error {
	return nil
}

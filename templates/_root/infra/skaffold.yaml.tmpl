---
apiVersion: skaffold/v4beta11
kind: Config

metadata:
  name: {{ .Project.ProjectMeta.Kebab }}-infra

profiles:
  # localdev profile - uses plain K8s manifests, no Helm required
  - name: localdev
    activation:
      - kubeContext: docker-desktop
    manifests:
      kustomize:
        paths:
          - deploy/environments/localdev/kustomize
    deploy:
      kubeContext: docker-desktop
      kubectl:
        defaultNamespace: localdev

  - name: prod
    build:
      tagPolicy:
        sha256: {}
      artifacts:
        - image: us-central1-docker.pkg.dev/{{ .Project.ProjectMeta.Kebab }}-prod/containers/caddy-cloudflare
          docker:
            dockerfile: docker/caddy-cloudflare/Dockerfile

    manifests:
      kustomize:
        paths:
          - deploy/environments/prod/kustomize

    deploy:
      kubectl:
        defaultNamespace: prod

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ .Project.ProjectMeta.Kebab }}-admin-webapp-deployment
  labels:
    app: {{ .Project.ProjectMeta.Kebab }}-admin-webapp
    app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-admin-webapp
spec:
  progressDeadlineSeconds: 1200
  selector:
    matchLabels:
      app: {{ .Project.ProjectMeta.Kebab }}-admin-webapp
      app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-admin-webapp
  replicas: 1
  template:
    metadata:
      labels:
        app: {{ .Project.ProjectMeta.Kebab }}-admin-webapp
        app.kubernetes.io/name: {{ .Project.ProjectMeta.Kebab }}-admin-webapp
    spec:
      containers:
        - name: {{ .Project.ProjectMeta.Kebab }}-admin-webapp
          image: {{ .Project.ProjectMeta.Kebab }}-admin-webapp
          imagePullPolicy: Always
          ports:
            - containerPort: 3000
              name: http
          livenessProbe:
            httpGet:
              path: '/_ops_/live'
              port: 3000
            initialDelaySeconds: 15
            periodSeconds: 10
            failureThreshold: 3
          readinessProbe:
            httpGet:
              path: '/_ops_/ready'
              port: 3000
            initialDelaySeconds: 10
            periodSeconds: 5
            failureThreshold: 3
          resources:
            requests:
              memory: '256Mi'
              cpu: '50m'
            limits:
              memory: '512Mi'
              cpu: '200m'
          env:
            - name: NODE_ENV
              value: 'production'
            - name: PORT
              value: '3000'

/// AuthManager manages authentication state, token storage, and login/register/logout flows.
@Observable
final class AuthManager {
    private(set) var isAuthenticated = false
    private(set) var currentUserID: String?
    private var authToken: String?

    private let client: GRPCClient

    init(client: GRPCClient = GRPCClient()) {
        self.client = client
        loadStoredToken()
    }

    /// Attempts to log in with the given credentials.
    func login(email: String, password: String) async throws {
        // TODO: implement gRPC login call
        // On success:
        // authToken = response.token
        // currentUserID = response.userID
        // client.authToken = authToken
        // isAuthenticated = true
        // storeToken(authToken)
        fatalError("TODO: implement login via gRPC")
    }

    /// Registers a new user account.
    func register(email: String, username: String, password: String) async throws {
        // TODO: implement gRPC registration call
        fatalError("TODO: implement registration via gRPC")
    }

    /// Logs out the current user.
    func logout() async {
        authToken = nil
        currentUserID = nil
        client.authToken = nil
        isAuthenticated = false
        clearStoredToken()
    }

    // MARK: - Token Persistence

    private func loadStoredToken() {
        guard let token = UserDefaults.standard.string(forKey: "{{ .Project.ProjectMeta.IOSModuleName }}.authToken") else {
            return
        }
        authToken = token
        client.authToken = token
        isAuthenticated = true
    }

    private func storeToken(_ token: String?) {
        UserDefaults.standard.set(token, forKey: "{{ .Project.ProjectMeta.IOSModuleName }}.authToken")
    }

    private func clearStoredToken() {
        UserDefaults.standard.removeObject(forKey: "{{ .Project.ProjectMeta.IOSModuleName }}.authToken")
    }
}

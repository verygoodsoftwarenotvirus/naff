// Package branding holds project-wide branding constants referenced by
// generated config, cmd, and service code. NAFF ships a minimal stub; users
// are expected to flesh it out with logo blobs, email templates, legal text,
// etc. Only the four constants below are load-bearing for the generated code.
package branding

const (
	// CompanyName is the human-readable project name.
	CompanyName = "{{ humanReadable .Project.ProjectMeta.Name }}"
	// CompanyNameSlug is the project name as a lowercase no-separator slug.
	CompanyNameSlug = "{{ lower .Project.ProjectMeta.Name }}"
	// CompanySlug is the project name as a kebab-case slug.
	CompanySlug = "{{ kebab .Project.ProjectMeta.Name }}"
	// EnvVarPrefix is the uppercase snake-case prefix applied to every
	// environment variable naff emits (e.g. DINNER_DONE_BETTER_SERVICE_NAME).
	EnvVarPrefix = "{{ upper (snake .Project.ProjectMeta.Name) }}_"
)

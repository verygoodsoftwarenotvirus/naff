package main

import (
	"fmt"
	"os"

	"{{ .Project.ProjectMeta.Module }}/internal/config"

	"{{ .Project.ProjectMeta.PlatformModule }}/version"

	"github.com/spf13/cobra"
	_ "go.uber.org/automaxprocs"
)

// Skeleton API server entry point. Intentionally minimal: it demonstrates
// config loading and version reporting but does not wire up HTTP/gRPC servers.
// Real wiring belongs in internal/build/services/api/ — a package naff does
// NOT emit in the generic path because target's version hardcodes every
// domain's imports. Users flesh out their own build.go here, or re-enable the
// DDB-style template once it's been refactored to iterate .AllDomains.
func main() {
	root := &cobra.Command{
		Use:   "server",
		Short: "API server CLI",
	}
	root.AddCommand(serveCmd())
	root.AddCommand(versionCmd())

	if err := root.Execute(); err != nil {
		os.Exit(1)
	}
}

func serveCmd() *cobra.Command {
	return &cobra.Command{
		Use:   "serve",
		Short: "Load config and print it (skeleton — wire HTTP/gRPC servers here)",
		RunE: func(_ *cobra.Command, _ []string) error {
			cfg, err := config.LoadConfigFromEnvironment[config.APIServiceConfig]()
			if err != nil {
				return fmt.Errorf("load config: %w", err)
			}
			fmt.Printf("loaded config: %+v\n", cfg)
			return nil
		},
	}
}

func versionCmd() *cobra.Command {
	return &cobra.Command{
		Use:   "version",
		Short: "Print version info as JSON (commit hash and build times)",
		RunE: func(_ *cobra.Command, _ []string) error {
			return version.WriteJSON()
		},
	}
}

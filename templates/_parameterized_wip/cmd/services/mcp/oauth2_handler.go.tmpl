package main

import (
	"net/http"

	"{{ .Project.ProjectMeta.PlatformModule }}/routing"
)

// registerOAuth2Routes mounts the OAuth2 endpoints required for the MCP server's
// bearer-token auth flow (authorization, token, well-known metadata, etc.).
//
// The body is a scaffold — fill in the OAuth2 authorization-code-with-PKCE flow
// against the project's identity service (and persist tokens via tokenStore).
func registerOAuth2Routes(router routing.Router, _ *tokenStore, baseURL string) {
	router.Get("/.well-known/oauth-protected-resource", func(res http.ResponseWriter, _ *http.Request) {
		// TODO: emit RFC 9728 protected-resource metadata pointing at the
		// authorization server URL the MCP client should use.
		res.Header().Set("Content-Type", "application/json")
		_, _ = res.Write([]byte(`{"resource":"` + baseURL + `/mcp"}`))
	})

	router.Get("/.well-known/oauth-authorization-server", func(res http.ResponseWriter, _ *http.Request) {
		// TODO: emit RFC 8414 authorization-server metadata.
		res.Header().Set("Content-Type", "application/json")
		_, _ = res.Write([]byte(`{"issuer":"` + baseURL + `"}`))
	})

	router.Post("/oauth/authorize", func(res http.ResponseWriter, _ *http.Request) {
		// TODO: implement /authorize per OAuth2.1 + PKCE.
		res.WriteHeader(http.StatusNotImplemented)
	})

	router.Post("/oauth/token", func(res http.ResponseWriter, _ *http.Request) {
		// TODO: implement /token (exchange code for access token, persist via tokenStore.storeToken).
		res.WriteHeader(http.StatusNotImplemented)
	})
}

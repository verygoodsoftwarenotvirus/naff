package main

import (
	"context"
	"log"
	"strings"

	"{{ .Project.ProjectMeta.Module }}/internal/config"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/identity"
	"{{ .Project.ProjectMeta.Module }}/internal/localdev"
)

const (
	apiConfigurationFilepath = "deploy/environments/testing/config_files/integration-tests-config.json"
)

// localdev/server runs an in-process all-in-one {{ .Project.ProjectMeta.Name }} stack
// (API + workers + dependencies) for local development without docker-compose,
// then seeds it with a premade admin user.
//
// Wire additional seed-data hooks (recipes, meal plans, etc.) by adding more
// localdev.With* options below — see dinnerdonebetter's meal_planning_bootstrap.go
// for an example of populating a complex domain.
func main() {
	ctx := context.Background()

	premadeAdminUser := &identity.User{
		ID:              strings.Repeat("a", 20),
		TwoFactorSecret: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=",
		EmailAddress:    "integration_tests@example.email",
		Username:        "admin_user",
		HashedPassword:  "admin_pass",
	}

	apiConfig, err := config.LoadConfigFromPath[config.APIServiceConfig](ctx, apiConfigurationFilepath)
	if err != nil {
		log.Fatal(err)
	}

	server, err := localdev.AllInOne(
		ctx,
		apiConfig,
		localdev.WithPremadeAdminUser(premadeAdminUser),
		// TODO: add additional WithXxxRepository(...) options to seed
		// project-specific data (recipes, products, etc.).
	)
	if err != nil {
		log.Fatal(err)
	}

	server.Run(ctx)
}

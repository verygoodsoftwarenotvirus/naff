package oauth

import (
	"{{ .Project.ProjectMeta.Module }}/internal/domain/audit"
	domainoauth "{{ .Project.ProjectMeta.Module }}/internal/domain/oauth"

	"{{ .Project.ProjectMeta.PlatformModule }}/database"
	databasecfg "{{ .Project.ProjectMeta.PlatformModule }}/database/config"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/logging"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/tracing"

	"github.com/samber/do/v2"
)

// RegisterOAuthRepository registers the OAuth repository with the injector.
func RegisterOAuthRepository(i do.Injector) {
	do.Provide[domainoauth.Repository](i, func(i do.Injector) (domainoauth.Repository, error) {
		return ProvideOAuthRepository(
			do.MustInvoke[logging.Logger](i),
			do.MustInvoke[tracing.TracerProvider](i),
			do.MustInvoke[audit.Repository](i),
			do.MustInvoke[*databasecfg.Config](i),
			do.MustInvoke[database.Client](i),
		), nil
	})
}

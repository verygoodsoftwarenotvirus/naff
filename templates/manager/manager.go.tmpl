package manager

import (
	"context"
	"fmt"

	"{{ .Project.ProjectMeta.Module }}/internal/domain/audit"
	"{{ .Project.ProjectMeta.Module }}/internal/domain/{{ .Domain.Name }}"
	{{ .Domain.Name }}keys "{{ .Project.ProjectMeta.Module }}/internal/domain/{{ .Domain.Name }}/keys"

	"{{ .Project.ProjectMeta.PlatformModule }}/database/filtering"
	"{{ .Project.ProjectMeta.PlatformModule }}/messagequeue"
	msgconfig "{{ .Project.ProjectMeta.PlatformModule }}/messagequeue/config"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/logging"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/tracing"
)

const (
	o11yName = "{{ snake .Entity.Name }}_data_manager"
)

var (
	_ {{ .Domain.Name }}.Repository       = (*{{ camel .Entity.Name }}Manager)(nil)
	_ {{ plural .Entity.Name }}DataManager = (*{{ camel .Entity.Name }}Manager)(nil)
)

type {{ camel .Entity.Name }}Manager struct {
	tracer               tracing.Tracer
	logger               logging.Logger
	repo                 {{ .Domain.Name }}.Repository
	dataChangesPublisher messagequeue.Publisher
}

// New{{ plural .Entity.Name }}DataManager returns a new {{ plural .Entity.Name }}DataManager.
func New{{ plural .Entity.Name }}DataManager(
	ctx context.Context,
	tracerProvider tracing.TracerProvider,
	logger logging.Logger,
	repo {{ .Domain.Name }}.Repository,
	cfg *msgconfig.QueuesConfig,
	publisherProvider messagequeue.PublisherProvider,
) ({{ plural .Entity.Name }}DataManager, error) {
	dataChangesPublisher, err := publisherProvider.ProvidePublisher(ctx, cfg.DataChangesTopicName)
	if err != nil {
		return nil, fmt.Errorf("failed to provide publisher for data changes topic: %w", err)
	}

	return &{{ camel .Entity.Name }}Manager{
		tracer:               tracing.NewNamedTracer(tracerProvider, o11yName),
		logger:               logging.NewNamedLogger(logger, o11yName),
		repo:                 repo,
		dataChangesPublisher: dataChangesPublisher,
	}, nil
}

func (m *{{ camel .Entity.Name }}Manager) Get{{ .Entity.Name }}(ctx context.Context, {{ camel .Entity.Name }}ID string) (*{{ .Domain.Name }}.{{ .Entity.Name }}, error) {
	ctx, span := m.tracer.StartSpan(ctx)
	defer span.End()
	return m.repo.Get{{ .Entity.Name }}(ctx, {{ camel .Entity.Name }}ID)
}

func (m *{{ camel .Entity.Name }}Manager) Get{{ plural .Entity.Name }}(ctx context.Context, filter *filtering.QueryFilter) (*filtering.QueryFilteredResult[{{ .Domain.Name }}.{{ .Entity.Name }}], error) {
	ctx, span := m.tracer.StartSpan(ctx)
	defer span.End()
	return m.repo.Get{{ plural .Entity.Name }}(ctx, filter)
}

{{- if .Entity.BelongsToAccount }}

func (m *{{ camel .Entity.Name }}Manager) Get{{ plural .Entity.Name }}ForAccount(ctx context.Context, accountID string, filter *filtering.QueryFilter) (*filtering.QueryFilteredResult[{{ .Domain.Name }}.{{ .Entity.Name }}], error) {
	ctx, span := m.tracer.StartSpan(ctx)
	defer span.End()
	return m.repo.Get{{ plural .Entity.Name }}ForAccount(ctx, accountID, filter)
}
{{- end }}

func (m *{{ camel .Entity.Name }}Manager) Create{{ .Entity.Name }}(ctx context.Context, input *{{ .Domain.Name }}.{{ .Entity.Name }}DatabaseCreationInput) (*{{ .Domain.Name }}.{{ .Entity.Name }}, error) {
	ctx, span := m.tracer.StartSpan(ctx)
	defer span.End()

	logger := m.logger.WithSpan(span)

	created, err := m.repo.Create{{ .Entity.Name }}(ctx, input)
	if err != nil {
		return nil, err
	}

	tracing.AttachToSpan(span, {{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, created.ID)
	m.dataChangesPublisher.PublishAsync(ctx, audit.BuildDataChangeMessageFromContext(ctx, logger, {{ .Domain.Name }}.{{ .Entity.Name }}CreatedServiceEventType, map[string]any{
		{{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey: created.ID,
	}))

	return created, nil
}

func (m *{{ camel .Entity.Name }}Manager) Update{{ .Entity.Name }}(ctx context.Context, {{ camel .Entity.Name }} *{{ .Domain.Name }}.{{ .Entity.Name }}) error {
	ctx, span := m.tracer.StartSpan(ctx)
	defer span.End()

	logger := m.logger.WithSpan(span).WithValue({{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}.ID)
	tracing.AttachToSpan(span, {{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}.ID)

	if err := m.repo.Update{{ .Entity.Name }}(ctx, {{ camel .Entity.Name }}); err != nil {
		return err
	}

	m.dataChangesPublisher.PublishAsync(ctx, audit.BuildDataChangeMessageFromContext(ctx, logger, {{ .Domain.Name }}.{{ .Entity.Name }}UpdatedServiceEventType, map[string]any{
		{{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey: {{ camel .Entity.Name }}.ID,
	}))

	return nil
}

func (m *{{ camel .Entity.Name }}Manager) Archive{{ .Entity.Name }}(ctx context.Context, {{ camel .Entity.Name }}ID string) error {
	ctx, span := m.tracer.StartSpan(ctx)
	defer span.End()

	logger := m.logger.WithSpan(span).WithValue({{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}ID)
	tracing.AttachToSpan(span, {{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey, {{ camel .Entity.Name }}ID)

	if err := m.repo.Archive{{ .Entity.Name }}(ctx, {{ camel .Entity.Name }}ID); err != nil {
		return err
	}

	m.dataChangesPublisher.PublishAsync(ctx, audit.BuildDataChangeMessageFromContext(ctx, logger, {{ .Domain.Name }}.{{ .Entity.Name }}ArchivedServiceEventType, map[string]any{
		{{ .Domain.Name }}keys.{{ .Entity.Name }}IDKey: {{ camel .Entity.Name }}ID,
	}))

	return nil
}

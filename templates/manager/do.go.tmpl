package manager

import (
	"context"

	"{{ .Project.ProjectMeta.Module }}/internal/domain/{{ .Domain.Name }}"

	"{{ .Project.ProjectMeta.PlatformModule }}/messagequeue"
	msgconfig "{{ .Project.ProjectMeta.PlatformModule }}/messagequeue/config"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/logging"
	"{{ .Project.ProjectMeta.PlatformModule }}/observability/tracing"

	"github.com/samber/do/v2"
)

// Register{{ plural .Entity.Name }}DataManager registers the {{ pluralHumanReadable .Entity.Name }} data manager with the injector.
func Register{{ plural .Entity.Name }}DataManager(i do.Injector) {
	do.Provide[{{ plural .Entity.Name }}DataManager](i, func(i do.Injector) ({{ plural .Entity.Name }}DataManager, error) {
		return New{{ plural .Entity.Name }}DataManager(
			do.MustInvoke[context.Context](i),
			do.MustInvoke[tracing.TracerProvider](i),
			do.MustInvoke[logging.Logger](i),
			do.MustInvoke[{{ .Domain.Name }}.Repository](i),
			do.MustInvoke[*msgconfig.QueuesConfig](i),
			do.MustInvoke[messagequeue.PublisherProvider](i),
		)
	})
}
